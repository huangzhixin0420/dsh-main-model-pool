{
  "name": "dsh-main-model-pool",
  "version": "0.1.0",
  "description": "主会话模型池：新建会话时按严格主备或均衡分配从候选模型池中选模型，每个候选独立并发上限；池内全满回退全局默认模型。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./pool": "./lib/pool.js",
    "./strategy": "./lib/strategy.js",
    "./fresh": "./lib/fresh.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
      "node": ">=20.18",
      "profiles": [
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-pool",
    "main-session"
  ]
}
